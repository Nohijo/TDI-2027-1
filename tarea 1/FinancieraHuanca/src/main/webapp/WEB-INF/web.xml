<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!--
        El servlet se registra con la anotacion @WebServlet dentro de
        CreditoServlet.java (urlPatterns = {"/credito"}).

        Si en tu clase lo hacen "a la antigua" con web.xml, borra la anotacion
        del .java y descomenta este bloque:

        <servlet>
            <servlet-name>CreditoServlet</servlet-name>
            <servlet-class>mx.unam.ciencias.tdi.CreditoServlet</servlet-class>
        </servlet>
        <servlet-mapping>
            <servlet-name>CreditoServlet</servlet-name>
            <url-pattern>/credito</url-pattern>
        </servlet-mapping>
    -->

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
