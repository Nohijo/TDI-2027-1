<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <display-name>FinancieraHuanca</display-name>

    <!-- Registro del servlet y su URL (estilo clasico, compatible con Tomcat 7) -->
    <servlet>
        <servlet-name>CreditoServlet</servlet-name>
        <servlet-class>mx.unam.ciencias.tdi.CreditoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreditoServlet</servlet-name>
        <url-pattern>/credito</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
