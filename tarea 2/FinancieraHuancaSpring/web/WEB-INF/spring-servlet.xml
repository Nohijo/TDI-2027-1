<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tarea 2 - Tecnologias para Desarrollos en Internet.

    Configuracion del contenedor de Spring que usa el DispatcherServlet:
    que clases son beans, como se resuelven las vistas y como se conecta a
    MySQL. Es el equivalente al archivo "<servlet>-servlet.xml" del ejemplo
    de clase FormularioDBSpring3MVC.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Busca las clases anotadas (@Controller, @Service, @Repository) y las
         registra como beans, inyectando lo que pida cada constructor. -->
    <context:component-scan base-package="mx.unam.ciencias.tdi"/>

    <!-- Enciende el soporte de anotaciones de Spring MVC (@GetMapping,
         @ModelAttribute, conversion de fechas y numeros, validacion...). -->
    <mvc:annotation-driven/>

    <!-- El DispatcherServlet atiende "/", asi que hay que decirle aparte
         de donde sirve los archivos estaticos. -->
    <mvc:resources mapping="/css/**" location="/css/"/>

    <!-- Datos de conexion, para no dejarlos escritos en este archivo. -->
    <context:property-placeholder location="classpath:db.properties"/>

    <!-- Origen de conexiones a MySQL. DriverManagerDataSource abre una
         conexion nueva cada vez: suficiente para esta tarea y evita
         depender de un pool externo. -->
    <bean id="dataSource"
          class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="com.mysql.cj.jdbc.Driver"/>
        <property name="url"      value="${db.url}"/>
        <property name="username" value="${db.usuario}"/>
        <property name="password" value="${db.password}"/>
    </bean>

    <!-- Lo que usa el DAO para consultar y guardar. -->
    <bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
        <constructor-arg ref="dataSource"/>
    </bean>

    <!-- Traduce el nombre que devuelve el Controller ("formulario") al JSP
         que lo pinta (/WEB-INF/vistas/formulario.jsp). Los JSP viven bajo
         WEB-INF para que nadie pueda abrirlos sin pasar por el Controller. -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/vistas/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

    <!-- Mensajes de error de conversion (messages.properties). -->
    <bean id="messageSource"
          class="org.springframework.context.support.ReloadableResourceBundleMessageSource">
        <property name="basename" value="classpath:messages"/>
        <property name="defaultEncoding" value="UTF-8"/>
    </bean>

</beans>
