<?xml version="1.0" encoding="UTF-8"?>
<project-shared-configuration>
<!--
Configuracion de NetBeans para este proyecto Maven.

DEV-NULL = "no quiero que el IDE administre el despliegue". Asi NetBeans
deja de pedir un servidor al dar Run (su selector aparece vacio con
Tomcat 10.1) y en su lugar se usa lo definido en nbactions.xml, que
levanta Tomcat con Cargo.

El perfil Jakarta EE 10 Web se deja declarado para que el editor entienda
las APIs de Servlets 6.0 / JSP.
-->
    <properties xmlns="http://www.netbeans.org/ns/maven-properties-data/1">
        <netbeans.hint.deploy.server>DEV-NULL</netbeans.hint.deploy.server>
        <netbeans.hint.j2eeVersion>10-web</netbeans.hint.j2eeVersion>
    </properties>
</project-shared-configuration>
