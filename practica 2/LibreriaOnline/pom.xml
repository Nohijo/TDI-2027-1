<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mx.unam.ciencias.tdi</groupId>
    <artifactId>LibreriaOnline</artifactId>
    <version>1.0</version>
    <packaging>war</packaging>

    <name>LibreriaOnline</name>
    <description>Practica 2 - Libreria en linea (MVC con Servlets y JSP)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 21 (para Tomcat 10.1 / Jakarta EE 10). -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <failOnMissingWebXml>false</failOnMissingWebXml>
        <!-- Carpeta donde esta instalado Apache Tomcat 10.1 (ver README). -->
        <tomcat.home>${user.home}/apache-tomcat-10.1.31</tomcat.home>
    </properties>

    <dependencies>
        <!--
            API de Servlets 6.0 = la que implementa Apache Tomcat 10.1.
            Paquete jakarta.servlet.*  (NO javax).
            scope "provided": la aporta Tomcat, no se empaqueta en el .war.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!--
            JSTL (Jakarta, para Tomcat 10.1) para las etiquetas <c:...> y
            <fmt:...> de las vistas JSP. Tomcat no la trae puesta: van en
            scope "compile" (por defecto) para empaquetarse en WEB-INF/lib.
            Hacen falta las dos: la API (las clases que el JSP referencia
            al compilar, como ConditionalTagSupport) y la implementacion.
        -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!--
            Conector JDBC de MySQL: permite que BookDAO hable con MySQL
            Server 8.0. Igual que JSTL, se empaqueta en WEB-INF/lib.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <!-- El .war se llamara LibreriaOnline.war -> contexto /LibreriaOnline -->
        <finalName>LibreriaOnline</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>

            <!--
                Cargo levanta el Tomcat 10.1 instalado y despliega el .war,
                sin depender del selector de servidores del IDE.
                "mvn cargo:run" = arrancar la aplicacion.
            -->
            <plugin>
                <groupId>org.codehaus.cargo</groupId>
                <artifactId>cargo-maven3-plugin</artifactId>
                <version>1.10.15</version>
                <configuration>
                    <container>
                        <containerId>tomcat10x</containerId>
                        <type>installed</type>
                        <home>${tomcat.home}</home>
                    </container>
                    <configuration>
                        <type>standalone</type>
                        <home>${project.build.directory}/tomcat10x</home>
                        <properties>
                            <cargo.servlet.port>8080</cargo.servlet.port>
                        </properties>
                    </configuration>
                    <deployables>
                        <deployable>
                            <groupId>mx.unam.ciencias.tdi</groupId>
                            <artifactId>LibreriaOnline</artifactId>
                            <type>war</type>
                            <properties>
                                <context>LibreriaOnline</context>
                            </properties>
                        </deployable>
                    </deployables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
