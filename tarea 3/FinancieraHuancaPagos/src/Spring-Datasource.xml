<beans xmlns="http://www.springframework.org/schema/beans"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <!-- Tarea 3 - Tecnologias para Desarrollos en Internet.
         Los datos de conexion no van escritos aqui, sino en
         servicio.properties, igual que en el ejemplo de clase. -->

    <bean
       class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
       <property name="location">
          <value>servicio.properties</value>
       </property>
    </bean>

    <!-- Lo usa CreditosJDBCTemplate (solicitudes, como en la Tarea 2) -->
    <bean id="servicioPropiedades" class="dominio.BDMySql">
      <property name="urlBD" value="${urlBD}"> </property>
      <property name="user" value="${user}"> </property>
      <property name="password" value="${password}"> </property>
    </bean>

    <!-- Tabla de pagos con tarjeta: DataSource + DAO, igual que en el
         Spring-Datasource.xml del ejemplo MultiRowDBSpring3MVC -->
    <bean id="financieraDS" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="${driverClassName}" />
        <property name="url" value="${urlBD}" />
        <property name="username" value="${user}" />
        <property name="password" value="${password}" />
    </bean>

    <bean id="pagoDAO" class="baseDeDatos.PagoDAO">
        <property name="dataSource" ref="financieraDS"/>
    </bean>
</beans>
